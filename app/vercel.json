{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/s/:path*",
      "destination": "/student-entry.html"
    },
    {
      "source": "/p",
      "destination": "/parent-entry.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build:vercel"
}
